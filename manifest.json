{
  "manifest_version": 2,
  "name": "AlterFox",
  "version": "1.0.0",
  "description": "Displays .md files with ACS-1 support and forced UTF-8 decoding.",
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.markdown",
        "*://*/*.mdown",
        "*://*/*.mdwn",
        "*://*/*.mkd",
        "*://*/*.mkdn"
      ],
      "js": ["showdown.min.js", "alterfox.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      // --- КЛЮЧЕВОЕ: Требование AMO для V2 ---
      // Указываем, что расширение НЕ собирает данные
      "strict_min_version": "58.0",   // Минимальная версия Firefox
      "data_collection_permissions": {
        // Это новое требование для всех новых расширений
        "required": ["none"] // <-- Вот оно!
      }
    }
  }
}
